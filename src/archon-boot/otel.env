# The boot server's own telemetry (spec 023): Deno's built-in OpenTelemetry,
# exported to the boot server's local sink on 127.0.0.1:4319 (this PC only).
# Loaded with --env-file by `deno task boot`, so the task line stays short.
OTEL_DENO=true
OTEL_SERVICE_NAME=archon-boot
OTEL_EXPORTER_OTLP_PROTOCOL=http/json
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4319
