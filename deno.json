{
  "name": "@stolos/archon",
  "exports": "./src/archon/main.ts",
  "tasks": {
    "archon": "deno run -A src/archon/main.ts",
    "boot": "deno run -A --env-file=src/archon-boot/otel.env src/archon-boot/main.ts",
    "test": "deno test -A tests/",
    "gen": "deno run -A tools/gen-assets.ts",
    "version": "deno run -A tools/version.ts",
    "ci": "deno run -A tools/gen-assets.ts --check && deno task check && deno lint && deno fmt --check && deno task test && deno task version check origin/main",
    "check": "deno check src/ tests/ examples/ tools/",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "imports": {
    "@stolos/": "./src/"
  },
  "compilerOptions": {
    "strict": true
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": [
      "out/",
      "examples/out/",
      "src/archon/assets.auto.ts",
      "state/",
      ".specify/",
      "home/"
    ]
  },
  "lint": {
    "rules": {
      "exclude": ["no-import-prefix"]
    },
    "exclude": [
      "out/",
      "examples/out/",
      "src/archon/assets.auto.ts",
      "state/",
      ".specify/",
      "home/"
    ]
  }
}
