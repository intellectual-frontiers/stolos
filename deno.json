{
  "name": "@stolos/archon",
  "exports": "./src/archon/main.ts",
  "tasks": {
    "stolos": "deno run -A src/stolos/main.ts",
    "archon": "deno run -A src/archon/main.ts",
    "docs": "deno run -A tools/docs.ts",
    "docs:lint": "deno run -A tools/docs.ts lint && deno check --doc src/",
    "docs:baseline": "deno run -A tools/docs.ts lint --update",
    "test": "deno test -A tests/",
    "gen": "deno run -A tools/gen-assets.ts",
    "version": "deno run -A tools/version.ts",
    "ci": "deno run -A tools/gen-assets.ts --check && deno task check && deno lint && deno fmt --check && deno task docs:lint && deno task test && deno task version check origin/main",
    "check": "deno check src/ tests/ examples/ tools/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "ocsf": "deno run -A tools/ocsf-gen.ts"
  },
  "imports": {
    "@stolos/": "./src/"
  },
  "compilerOptions": {
    "strict": true
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": [
      "out/",
      "examples/out/",
      "src/archon/assets.auto.ts",
      "src/archon/modules.auto.ts",
      "state/",
      ".specify/",
      "home/",
      "vendor/",
      ".claude/"
    ]
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-import-prefix"
      ]
    },
    "exclude": [
      "out/",
      "examples/out/",
      "src/archon/assets.auto.ts",
      "src/archon/modules.auto.ts",
      "state/",
      ".specify/",
      "home/",
      "vendor/",
      ".claude/"
    ]
  }
}
