# AUTO-GENERATED by tools/ontology.ts (bun run gen) from ontology/stolos/vocabulary.ts, ontology/stolos/codes.ts, ontology/stolos/architecture.ts, ontology/stolos/audit.ts (spec 101-ladder FR-005). Do not edit: change the ontology.

@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix mz: <https://www.intellectualfrontiers.com/ontology/mizan#> .
@prefix mzid: <https://www.intellectualfrontiers.com/id/mizan/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix stolos: <https://intellectual-frontiers.github.io/stolos/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

stolos:AddressBlock a owl:Class ;
    rdfs:label "Address block"@en ;
    skos:definition "A client address that is refused for the rest of a pairing session after five wrong signatures from it; other addresses are not affected."@en ;
    stolos:spec "107-pairing-and-query FR-004" .

stolos:AdoptedMachine a owl:Class ;
    rdfs:label "Adopted machine"@en ;
    skos:definition "A machine Stolos did not install: recorded, observed by a probe and held to policies, never converged."@en ;
    stolos:spec "067-adopt" .

stolos:AnswerState a owl:Class ;
    rdfs:label "Answer state"@en ;
    skos:definition "Where one machine is in a question to every machine: asking, answered, failed, or timed out."@en ;
    stolos:spec "107-pairing-and-query FR-010, FR-011" .

stolos:ApiCapability a owl:Class ;
    rdfs:label "API capability"@en ;
    skos:definition "One thing an integration of a kind may read, written `<kind>-<capability>` (`router-clients`, `dns-zones`, `email-routing`): a type-level fact, so that asking for a capability an integration does not offer does not compile."@en ;
    stolos:spec "109-integrations-api FR-001, FR-002" .

stolos:ApiIntegration a owl:Class ;
    rdfs:label "API integration"@en ;
    skos:definition "An account's API read through the integration layer: it declares its kind (a router, a DNS provider, an email provider) and the capabilities of that kind it offers, and a function that needs a capability accepts only an integration that offers it."@en ;
    stolos:spec "109-integrations-api FR-001, FR-002" .

stolos:ApiKind a owl:Class ;
    rdfs:label "API kind"@en ;
    skos:definition "What an account's API is a kind of: a router, a DNS provider or an email provider. Each kind has its own set of capabilities (`stolos:ApiCapability`)."@en ;
    stolos:spec "109-integrations-api FR-001" .

stolos:Capability a owl:Class ;
    rdfs:label "Capability"@en ;
    skos:definition "A part of a host's model that contributes packages, files, units, ports and tools, each with its verification."@en ;
    stolos:spec "002-model FR-003" .

stolos:Check a owl:Class ;
    rdfs:label "Check"@en ;
    skos:definition "A test of evidence against a control: a policy of a machine, or a control of the control SDK."@en ;
    stolos:spec "078-control-sdk" .

stolos:CommandTier a owl:Class ;
    rdfs:label "Command tier"@en ;
    skos:definition "What a command may do: read, write the repository, change the host, or destroy."@en ;
    stolos:spec "030-agent-layer FR-003" .

stolos:ConsoleDevice a owl:Class ;
    rdfs:label "Console device"@en ;
    skos:definition "A browser registered with a passkey to sign in to the Stolos Console at its own HTTPS name, approved by a signer."@en ;
    stolos:spec "100-remote-access FR-004" .

stolos:ConsoleName a owl:Class ;
    rdfs:label "Console name"@en ;
    skos:definition "An HTTPS name of the Stolos Console under the fleet's web domain, with its DNS record and certificate."@en ;
    stolos:spec "100-remote-access FR-001, FR-002" .

stolos:Controller a owl:Class ;
    rdfs:label "Controller"@en ;
    rdfs:subClassOf stolos:AdoptedMachine ;
    skos:definition "The PC that runs `stolos`: an adopted machine with the role controller, observed locally, with no SSH server."@en ;
    stolos:spec "097-controller FR-001" .

stolos:DataClass a owl:Class ;
    rdfs:label "Data class"@en ;
    skos:definition "Whether data from end users is durable (it exists nowhere else) or ephemeral (losing it is harmless) (Article 23)."@en ;
    stolos:spec "044-durable FR-001" .

stolos:Decision a owl:Class ;
    rdfs:label "Decision"@en ;
    skos:definition "A file in a fleet repository that holds what a person decided, sent only by the command that made the decision."@en ;
    stolos:spec "047-intent-and-identity FR-006",
        "100-remote-access" .

stolos:Device a owl:Class ;
    rdfs:label "Device"@en ;
    skos:definition "A printer, router, switch or other appliance, read over SNMP."@en ;
    stolos:spec "069-integrate FR-005" .

stolos:DevicePath a owl:Class ;
    rdfs:label "Device path"@en ;
    skos:definition "A URL path prefix under `/device/`, the namespace reserved for device-specific endpoints on the controller's listeners; pairing is the first."@en ;
    stolos:spec "103-three-ports FR-003" .

stolos:DnsRecord a owl:Class ;
    rdfs:label "DNS record"@en ;
    skos:definition "A record of a zone: its name, type, content, time to live and whether the provider proxies it."@en ;
    stolos:spec "109-integrations-api FR-001, FR-007" .

stolos:DnsZone a owl:Class ;
    rdfs:label "DNS zone"@en ;
    skos:definition "A zone a DNS provider serves for a domain, with its status and whether it is signed (DNSSEC)."@en ;
    stolos:spec "109-integrations-api FR-001, FR-007" .

stolos:Door a owl:Class ;
    rdfs:label "Door"@en ;
    skos:definition "A way a machine reaches the pairing: plain HTTP on the boot server's port (the same trust as PXE) or TLS on the console's port, both serving one handler."@en ;
    stolos:spec "103-three-ports FR-004" .

stolos:EmailDomain a owl:Class ;
    rdfs:label "Email domain"@en ;
    skos:definition "A domain as its email depends on it: its MX records, and whether it publishes SPF, DKIM and DMARC records and has email routing on."@en ;
    stolos:spec "109-integrations-api FR-001, FR-008" .

stolos:EmailRoute a owl:Class ;
    rdfs:label "Email route"@en ;
    skos:definition "A rule of an email routing service: the address it matches, whether it is enabled and what it does with a message (without the addresses it forwards to)."@en ;
    stolos:spec "109-integrations-api FR-001, FR-008" .

stolos:EmailSender a owl:Class ;
    rdfs:label "Email sender"@en ;
    skos:definition "A way a domain sends email through a provider: the sending domain and how it is authenticated."@en ;
    stolos:spec "109-integrations-api FR-001, FR-008" .

stolos:EngineRelease a owl:Class ;
    rdfs:label "Engine release"@en ;
    skos:definition "A version of Stolos, an ifr:Release of the one work `stolos`: the annotated Git tag `stolos-v<version>` on the engine's main, that a fleet pins and stolos update adopts."@en ;
    stolos:spec "099-engine-update FR-001, FR-002",
        "114-release-record FR-004, FR-005" .

stolos:FileKind a owl:Class ;
    rdfs:label "File kind"@en ;
    skos:definition "Whether a file Stolos writes is a record (sent by update) or a decision (sent by the command that decided)."@en ;
    stolos:spec "099-engine-update FR-006" .

stolos:Finding a owl:Class ;
    rdfs:label "Finding"@en ;
    skos:definition "What a check found, with its SCF controls, its severity and its fix, written as OCSF."@en ;
    stolos:spec "068-compliance",
        "089-ocsf-schema-language" .

stolos:FirewallRule a owl:Class ;
    rdfs:label "Firewall rule"@en ;
    skos:definition "A rule of a router's firewall: its action, the zones it applies between, whether it is enabled, and whether the system or a person made it."@en ;
    stolos:spec "109-integrations-api FR-001, FR-013" .

stolos:Fleet a owl:Class ;
    rdfs:label "Fleet"@en ;
    skos:definition "A set of machines under one identity, site and list of signers, kept in `fleets/<id>/` of an operator's repository."@en ;
    stolos:spec "002-model FR-001",
        "082-multi-fleet" .

stolos:Host a owl:Class ;
    rdfs:label "Host"@en ;
    skos:definition "A managed server or workstation: installed from its model and converged by `archon`."@en ;
    stolos:spec "002-model" .

stolos:IntegrationKind a owl:Class ;
    rdfs:label "Integration kind"@en ;
    skos:definition "What a machine integrates as: discovered, adopted, with osquery, as a server or as a workstation."@en ;
    stolos:spec "069-integrate" .

stolos:Lease a owl:Class ;
    rdfs:label "DHCP lease"@en ;
    skos:definition "An address a router's DHCP server has given to a client, with the client's MAC address and when the lease ends."@en ;
    stolos:spec "109-integrations-api FR-001, FR-014" .

stolos:LineKind a owl:Class ;
    rdfs:label "Line kind"@en ;
    skos:definition "What a line of a run is: a step that went well, a problem, something for the person to do, something waiting, a hint, or an outcome the person needs."@en ;
    stolos:spec "105-calm-output FR-003" .

stolos:Listener a owl:Class ;
    rdfs:label "Listener"@en ;
    skos:definition "One of the three sockets the controller PC opens for Stolos (UDP 69 and TCP 8080 for the boot server, TCP 443 for the console over TLS): its protocol and port. Every other exchange is a route on one of them or is loopback-only (Article 29)."@en ;
    stolos:spec "103-three-ports FR-001, FR-002" .

stolos:MachineKind a owl:Class ;
    rdfs:label "Machine kind"@en ;
    skos:definition "What a machine of a fleet is to Stolos: managed, adopted, a device, a cloud's, discovered, or the controller."@en ;
    stolos:spec "066-stolos-console FR-003" .

stolos:MachineTable a owl:Class ;
    rdfs:label "Machine table"@en ;
    skos:definition "The one merged table of a question asked to every machine: a row per answer, and a row for each machine that failed or timed out with its reason, drawn by the console's vendored grid."@en ;
    stolos:spec "107-pairing-and-query FR-012, FR-013" .

stolos:NetworkClient a owl:Class ;
    rdfs:label "Network client"@en ;
    skos:definition "A device connected to a network as the router sees it: its name, type (wired, wireless, VPN), MAC and IP address, and the device it is connected through."@en ;
    stolos:spec "109-integrations-api FR-001, FR-013" .

stolos:NetworkDevice a owl:Class ;
    rdfs:label "Network device"@en ;
    skos:definition "A device a network is made of and a controller has adopted (a gateway, a switch, an access point): its name, model, MAC and IP address, state and firmware."@en ;
    stolos:spec "109-integrations-api FR-001, FR-013, FR-015" .

stolos:OutcomeLevel a owl:Class ;
    rdfs:label "Outcome level"@en ;
    skos:definition "How a step ended, as every command line and console shows it, with its mark."@en ;
    stolos:spec "099-engine-update FR-007" .

stolos:OutputClass a owl:Class ;
    rdfs:label "Output class"@en ;
    skos:definition "What a command is for: a report is read as a whole (verbose by default), an action does something (calm by default)."@en ;
    stolos:spec "105-calm-output FR-001" .

stolos:PairingCode a owl:Class ;
    rdfs:label "Pairing code"@en ;
    skos:definition "Eight characters with no look-alikes that a person types on a machine to pair it with the controller; every message after the script is signed with it."@en ;
    stolos:spec "098-pair FR-002, FR-004" .

stolos:PairingSession a owl:Class ;
    rdfs:label "Pairing session"@en ;
    skos:definition "What one `stolos pair` keeps while it runs: a code every machine may use, the machines that said hello and where each one is, and the client addresses refused. It stays open until the person who started it stops it; nothing is adopted without that person's yes, machine by machine."@en ;
    stolos:spec "107-pairing-and-query FR-001, FR-002, FR-003" .

stolos:PairingStage a owl:Class ;
    rdfs:label "Pairing stage"@en ;
    skos:definition "Where one machine is in a pairing session: said hello, installing, waiting for the person, adopted, or refused."@en ;
    stolos:spec "107-pairing-and-query FR-002, FR-003" .

stolos:PassphraseSession a owl:Class ;
    rdfs:label "Passphrase session"@en ;
    skos:definition "The daily key's passphrase held in the memory of one command, and of the runs nested in it, from the first time it is asked to the end of the command: handed to a signing tool by a per-run askpass helper, never stored, never in an environment variable, a file, a log or an argument, and wiped when the command ends."@en ;
    stolos:spec "106-one-passphrase-speed FR-001, FR-002" .

stolos:PhaseTiming a owl:Class ;
    rdfs:label "Phase timing"@en ;
    skos:definition "A line of a run's log that says how long a phase took, in milliseconds, and a closing line for the whole run: for finding what is slow, never drawn on the screen."@en ;
    stolos:spec "106-one-passphrase-speed FR-010" .

stolos:PortForward a owl:Class ;
    rdfs:label "Port forward"@en ;
    skos:definition "A rule that sends traffic arriving at a port of the router's public address to an address and port inside the network."@en ;
    stolos:spec "109-integrations-api FR-001, FR-014" .

stolos:ProbeCache a owl:Class ;
    rdfs:label "Probe cache"@en ;
    skos:definition "What an earlier run found out about this PC's firewall, kept for a short time in the program's state folder so that the next run does not ask the system again; never stale across a rule change by more than its time to live."@en ;
    stolos:spec "106-one-passphrase-speed FR-008" .

stolos:Record a owl:Class ;
    rdfs:label "Record"@en ;
    skos:definition "A file Stolos writes in a fleet repository about what happened (a registration, an observation): sent by `stolos update`."@en ;
    stolos:spec "099-engine-update FR-006" .

stolos:Route a owl:Class ;
    rdfs:label "Route"@en ;
    skos:definition "An entry of a router's routing table: a destination network, its next hop and the interface it leaves by."@en ;
    stolos:spec "109-integrations-api FR-001, FR-014" .

stolos:RouterHealth a owl:Class ;
    rdfs:label "Router health"@en ;
    skos:definition "What a controller says of its own health: the version of its application and how many of its devices are online and offline."@en ;
    stolos:spec "109-integrations-api FR-001, FR-013" .

stolos:Signer a owl:Class ;
    rdfs:label "Signer"@en ;
    skos:definition "A person's key on a fleet's list of signers: a host applies only a tip of main one of them signed (Article 9)."@en ;
    stolos:spec "047-intent-and-identity FR-001" .

stolos:SignerRole a owl:Class ;
    rdfs:label "Signer role"@en ;
    skos:definition "daily (approves changes) or recovery (kept offline, replaces a lost daily key)."@en ;
    stolos:spec "047-intent-and-identity FR-001" .

stolos:SigningOutcome a owl:Class ;
    rdfs:label "Signing outcome"@en ;
    skos:definition "How an attempt to sign ended, which decides what happens to the passphrase held in memory: kept, thrown away and asked again, or thrown away."@en ;
    stolos:spec "106-one-passphrase-speed FR-003" .

stolos:SwitchPort a owl:Class ;
    rdfs:label "Switch port"@en ;
    skos:definition "One port of a switch or gateway: its index, state, speed, connector and power over Ethernet."@en ;
    stolos:spec "109-integrations-api FR-001, FR-013" .

stolos:Tag a owl:Class ;
    rdfs:label "Tag"@en ;
    skos:definition "A label a fleet gives to machines, written `<dimension>:<value>` and defined in the fleet's own `tags.ts` (an id, a label, a colour and a description); or a free-form tag, a lowercase word with no colon, which is never defined and is always shown as custom."@en ;
    stolos:spec "108-tags FR-001, FR-004, FR-005" .

stolos:TagCardinality a owl:Class ;
    rdfs:label "Tag cardinality"@en ;
    skos:definition "How many values of a tag dimension one machine may hold: one-of (at most one) or many-of (any number)."@en ;
    stolos:spec "108-tags FR-001, FR-004" .

stolos:TagColour a owl:Class ;
    rdfs:label "Tag colour"@en ;
    skos:definition "A named colour of the console's palette that a defined tag is drawn in, light and dark."@en ;
    stolos:spec "108-tags FR-001" .

stolos:TagDimension a owl:Class ;
    rdfs:label "Tag dimension"@en ;
    skos:definition "A family of tags that answer one question about a machine (its environment, its role, its site, its owner, its criticality, its data class): one-of when a machine holds at most one of its values, many-of when it may hold several."@en ;
    stolos:spec "108-tags FR-001, FR-003" .

stolos:TagGroup a owl:Class ;
    rdfs:label "Tag group"@en ;
    skos:definition "A group in the fleet's `tags.ts` (a site network, an address range, or named machines) whose tags every member inherits; the tag shows the group as its origin."@en ;
    stolos:spec "108-tags FR-010" .

stolos:TagOrigin a owl:Class ;
    rdfs:label "Tag origin"@en ;
    skos:definition "Where a tag on a machine came from: a person (added by `stolos tag add` or at pairing), a rule of `tags.ts`, or a group it inherits from."@en ;
    stolos:spec "108-tags FR-009, FR-010, FR-011" .

stolos:TagRule a owl:Class ;
    rdfs:label "Tag rule"@en ;
    skos:definition "A rule in the fleet's `tags.ts`, written in TypeScript over what Stolos knows of a machine (its operating system, address, kind, name, owner), that gives the machine a defined tag whenever it holds; the tag shows the rule as its origin."@en ;
    stolos:spec "108-tags FR-009" .

stolos:TagSelection a owl:Class ;
    rdfs:label "Tag selection"@en ;
    skos:definition "A choice of machines by their tags: tags that must all hold, tags of which one must hold, or a small expression (`env:prod and not role:db`) read by a typed parser, never evaluated as code."@en ;
    stolos:spec "108-tags FR-012, FR-013" .

stolos:TrustedNetwork a owl:Class ;
    rdfs:label "Trusted network"@en ;
    skos:definition "The site's LAN, or a zero trust mesh network the fleet chooses, on which the fleet's own short, content-authenticated exchanges run (Article 28)."@en ;
    stolos:spec "098-pair FR-008, FR-010" .

stolos:Verbosity a owl:Class ;
    rdfs:label "Verbosity"@en ;
    skos:definition "How much of a run reaches the screen: nothing but a verdict line, only what needs a person, every line, or JSON."@en ;
    stolos:spec "105-calm-output FR-002" .

stolos:Vlan a owl:Class ;
    rdfs:label "VLAN"@en ;
    skos:definition "A network of a router with its VLAN id (IEEE 802.1Q), whether it is enabled and whether it is the default one."@en ;
    stolos:spec "109-integrations-api FR-001, FR-013" .

stolos:WayOfJoining a owl:Class ;
    rdfs:label "Way of joining"@en ;
    skos:definition "How a machine came to be in the fleet: auto-adopted (the controller), paired, integrated, managed, or cloud."@en ;
    stolos:spec "107-pairing-and-query FR-007" .

stolos:WifiNetwork a owl:Class ;
    rdfs:label "Wi-Fi network"@en ;
    skos:definition "A Wi-Fi network an access point broadcasts: its name, whether it is enabled, the frequencies it uses and how it is secured."@en ;
    stolos:spec "109-integrations-api FR-001, FR-013" .

stolos:answer-answered a stolos:AnswerState ;
    rdfs:label "answered"@en ;
    skos:definition "The machine answered, with rows or none."@en ;
    skos:notation "answered" ;
    stolos:spec "107-pairing-and-query FR-011" .

stolos:answer-asking a stolos:AnswerState ;
    rdfs:label "asking"@en ;
    skos:definition "The machine is being asked: its answer has not come yet."@en ;
    skos:notation "asking" ;
    stolos:spec "107-pairing-and-query FR-010" .

stolos:answer-failed a stolos:AnswerState ;
    rdfs:label "failed"@en ;
    skos:definition "The machine could not be asked, or refused, with its reason."@en ;
    skos:notation "failed" ;
    stolos:spec "107-pairing-and-query FR-011" .

stolos:answer-timed-out a stolos:AnswerState ;
    rdfs:label "timed out"@en ;
    skos:definition "The machine did not answer within the time limit of each machine."@en ;
    skos:notation "timed-out" ;
    stolos:spec "107-pairing-and-query FR-010" .

stolos:api-capability-dns-records a stolos:ApiCapability ;
    rdfs:label "dns records"@en ;
    skos:definition "Reads the records of those zones."@en ;
    skos:notation "dns-records" ;
    stolos:spec "109-integrations-api FR-001" .

stolos:api-capability-dns-zones a stolos:ApiCapability ;
    rdfs:label "dns zones"@en ;
    skos:definition "Reads the zones the provider serves."@en ;
    skos:notation "dns-zones" ;
    stolos:spec "109-integrations-api FR-001" .

stolos:api-capability-email-domains a stolos:ApiCapability ;
    rdfs:label "email domains"@en ;
    skos:definition "Reads the domains it handles and their email DNS records."@en ;
    skos:notation "email-domains" ;
    stolos:spec "109-integrations-api FR-001" .

stolos:api-capability-email-routing a stolos:ApiCapability ;
    rdfs:label "email routing"@en ;
    skos:definition "Reads its rules for inbound mail."@en ;
    skos:notation "email-routing" ;
    stolos:spec "109-integrations-api FR-001" .

stolos:api-capability-email-sending a stolos:ApiCapability ;
    rdfs:label "email sending"@en ;
    skos:definition "Reads how the domains send mail through it."@en ;
    skos:notation "email-sending" ;
    stolos:spec "109-integrations-api FR-001" .

stolos:api-capability-router-clients a stolos:ApiCapability ;
    rdfs:label "router clients"@en ;
    skos:definition "Reads the clients connected to it."@en ;
    skos:notation "router-clients" ;
    stolos:spec "109-integrations-api FR-001" .

stolos:api-capability-router-devices a stolos:ApiCapability ;
    rdfs:label "router devices"@en ;
    skos:definition "Reads the devices it manages."@en ;
    skos:notation "router-devices" ;
    stolos:spec "109-integrations-api FR-001" .

stolos:api-capability-router-dhcp-leases a stolos:ApiCapability ;
    rdfs:label "router dhcp-leases"@en ;
    skos:definition "Reads the DHCP leases the router has given."@en ;
    skos:notation "router-dhcp-leases" ;
    stolos:spec "109-integrations-api FR-001" .

stolos:api-capability-router-firewall-rules a stolos:ApiCapability ;
    rdfs:label "router firewall-rules"@en ;
    skos:definition "Reads its firewall rules."@en ;
    skos:notation "router-firewall-rules" ;
    stolos:spec "109-integrations-api FR-001" .

stolos:api-capability-router-health a stolos:ApiCapability ;
    rdfs:label "router health"@en ;
    skos:definition "Reads its health."@en ;
    skos:notation "router-health" ;
    stolos:spec "109-integrations-api FR-001" .

stolos:api-capability-router-networks-and-vlans a stolos:ApiCapability ;
    rdfs:label "router networks-and-vlans"@en ;
    skos:definition "Reads its networks and VLANs."@en ;
    skos:notation "router-networks-and-vlans" ;
    stolos:spec "109-integrations-api FR-001" .

stolos:api-capability-router-port-forwards a stolos:ApiCapability ;
    rdfs:label "router port-forwards"@en ;
    skos:definition "Reads its port forwards."@en ;
    skos:notation "router-port-forwards" ;
    stolos:spec "109-integrations-api FR-001" .

stolos:api-capability-router-ports a stolos:ApiCapability ;
    rdfs:label "router ports"@en ;
    skos:definition "Reads the ports of its switches."@en ;
    skos:notation "router-ports" ;
    stolos:spec "109-integrations-api FR-001" .

stolos:api-capability-router-routes a stolos:ApiCapability ;
    rdfs:label "router routes"@en ;
    skos:definition "Reads its routes."@en ;
    skos:notation "router-routes" ;
    stolos:spec "109-integrations-api FR-001" .

stolos:api-capability-router-wifi a stolos:ApiCapability ;
    rdfs:label "router wifi"@en ;
    skos:definition "Reads its Wi-Fi networks."@en ;
    skos:notation "router-wifi" ;
    stolos:spec "109-integrations-api FR-001" .

stolos:api-kind-dns a stolos:ApiKind ;
    rdfs:label "DNS"@en ;
    skos:definition "A DNS provider: the zones it serves and their records."@en ;
    skos:notation "dns" ;
    stolos:spec "109-integrations-api FR-001" .

stolos:api-kind-email a stolos:ApiKind ;
    rdfs:label "email"@en ;
    skos:definition "An email provider: the domains it handles, how it sends and how it routes inbound mail."@en ;
    skos:notation "email" ;
    stolos:spec "109-integrations-api FR-001" .

stolos:api-kind-router a stolos:ApiKind ;
    rdfs:label "router"@en ;
    skos:definition "A router and the controller that manages it: its clients, devices, networks, ports and firewall."@en ;
    skos:notation "router" ;
    stolos:spec "109-integrations-api FR-001" .

stolos:ascii a owl:DatatypeProperty ;
    rdfs:domain stolos:OutcomeLevel ;
    rdfs:label "ASCII mark"@en ;
    rdfs:range xsd:string ;
    skos:definition "The mark of an outcome level where the terminal shows ASCII alone (commons 0006-signals FR-027)."@en ;
    stolos:spec "099-engine-update FR-007" .

stolos:cardinality-many-of a stolos:TagCardinality ;
    rdfs:label "many of"@en ;
    skos:definition "A machine may hold any number of the dimension's values (its roles)."@en ;
    skos:notation "many-of" ;
    stolos:spec "108-tags FR-004" .

stolos:cardinality-one-of a stolos:TagCardinality ;
    rdfs:label "one of"@en ;
    skos:definition "A machine holds at most one value of the dimension (an environment: prod, staging or lab)."@en ;
    skos:notation "one-of" ;
    stolos:spec "108-tags FR-004" .

stolos:colour-blue a stolos:TagColour ;
    rdfs:label "blue"@en ;
    skos:definition "A calm accent for roles and sites."@en ;
    skos:notation "blue" ;
    stolos:spec "108-tags FR-001" .

stolos:colour-green a stolos:TagColour ;
    rdfs:label "green"@en ;
    skos:definition "For what is safe to touch: lab, low criticality, public data."@en ;
    skos:notation "green" ;
    stolos:spec "108-tags FR-001" .

stolos:colour-grey a stolos:TagColour ;
    rdfs:label "grey"@en ;
    skos:definition "Neutral: the default of a tag that has no colour of its own."@en ;
    skos:notation "grey" ;
    stolos:spec "108-tags FR-001" .

stolos:colour-orange a stolos:TagColour ;
    rdfs:label "orange"@en ;
    skos:definition "A warm accent, between red and yellow."@en ;
    skos:notation "orange" ;
    stolos:spec "108-tags FR-001" .

stolos:colour-pink a stolos:TagColour ;
    rdfs:label "pink"@en ;
    skos:definition "A soft accent for anything else."@en ;
    skos:notation "pink" ;
    stolos:spec "108-tags FR-001" .

stolos:colour-red a stolos:TagColour ;
    rdfs:label "red"@en ;
    skos:definition "For what needs care: production, high criticality."@en ;
    skos:notation "red" ;
    stolos:spec "108-tags FR-001" .

stolos:colour-teal a stolos:TagColour ;
    rdfs:label "teal"@en ;
    skos:definition "A cool accent, between green and blue."@en ;
    skos:notation "teal" ;
    stolos:spec "108-tags FR-001" .

stolos:colour-violet a stolos:TagColour ;
    rdfs:label "violet"@en ;
    skos:definition "An accent for owners and teams."@en ;
    skos:notation "violet" ;
    stolos:spec "108-tags FR-001" .

stolos:colour-yellow a stolos:TagColour ;
    rdfs:label "yellow"@en ;
    skos:definition "A caution accent."@en ;
    skos:notation "yellow" ;
    stolos:spec "108-tags FR-001" .

stolos:data-durable a stolos:DataClass ;
    rdfs:label "durable"@en ;
    skos:definition "It exists nowhere else."@en ;
    skos:notation "durable" ;
    stolos:spec "044-durable FR-001" .

stolos:data-ephemeral a stolos:DataClass ;
    rdfs:label "ephemeral"@en ;
    skos:definition "Losing it is harmless."@en ;
    skos:notation "ephemeral" ;
    stolos:spec "044-durable FR-001" .

stolos:devicepath-pair a stolos:DevicePath ;
    rdfs:label "pair"@en ;
    skos:definition "Pairing: the scripts, the hello and the check-in of a machine joining the fleet. `/device/` is reserved for device-specific endpoints; pairing is the first."@en ;
    skos:notation "pair" ;
    stolos:pathPrefix "/device/pair" ;
    stolos:spec "103-three-ports FR-003" .

stolos:door-lan-http a stolos:Door ;
    rdfs:label "LAN HTTP"@en ;
    skos:definition "Plain HTTP on the boot server's port, on a trusted network (Article 28): the boot server's own, or a pair-only server `stolos pair` runs when boot serve is not."@en ;
    skos:notation "lan-http" ;
    stolos:onListener stolos:listener-boot-http ;
    stolos:spec "103-three-ports FR-004" .

stolos:door-tls a stolos:Door ;
    rdfs:label "TLS"@en ;
    skos:definition "TLS on the console's port, for the console's LAN names only, when `stolos console --lan` is serving."@en ;
    skos:notation "tls" ;
    stolos:onListener stolos:listener-console-https ;
    stolos:spec "103-three-ports FR-004" .

stolos:emoji a owl:DatatypeProperty ;
    rdfs:domain stolos:OutcomeLevel ;
    rdfs:label "emoji"@en ;
    rdfs:range xsd:string ;
    skos:definition "The mark of an outcome level where the terminal shows emoji (commons 0006-signals FR-022)."@en ;
    stolos:spec "099-engine-update FR-007" .

stolos:file-decision a stolos:FileKind ;
    rdfs:label "decision"@en ;
    skos:definition "What a person decided: sent by the command that decided, signed by whoever decided."@en ;
    skos:notation "decision" ;
    stolos:spec "100-remote-access" .

stolos:file-record a stolos:FileKind ;
    rdfs:label "record"@en ;
    skos:definition "What happened (a registration, an observation): sent by stolos update, expected, never alarming."@en ;
    skos:notation "record" ;
    stolos:spec "099-engine-update FR-006" .

stolos:integration-adopt a stolos:IntegrationKind ;
    rdfs:label "adopt"@en ;
    skos:definition "Adopted: observed by its probe over SSH."@en ;
    skos:notation "adopt" ;
    stolos:spec "069-integrate" .

stolos:integration-discover a stolos:IntegrationKind ;
    rdfs:label "discover"@en ;
    skos:definition "Recorded as discovered."@en ;
    skos:notation "discover" ;
    stolos:spec "069-integrate" .

stolos:integration-osquery a stolos:IntegrationKind ;
    rdfs:label "osquery"@en ;
    skos:definition "Adopted, with osquery installed."@en ;
    skos:notation "osquery" ;
    stolos:spec "069-integrate",
        "093-osquery" .

stolos:integration-server a stolos:IntegrationKind ;
    rdfs:label "server"@en ;
    skos:definition "Made a managed server."@en ;
    skos:notation "server" ;
    stolos:spec "069-integrate" .

stolos:integration-workstation a stolos:IntegrationKind ;
    rdfs:label "workstation"@en ;
    skos:definition "Made a managed workstation."@en ;
    skos:notation "workstation" ;
    stolos:spec "069-integrate" .

stolos:joined-auto-adopted a stolos:WayOfJoining ;
    rdfs:label "auto-adopted"@en ;
    skos:definition "The controller PC, which the fleet adopts by itself (spec 097): it needs no pairing and is observed by the local probe."@en ;
    skos:notation "auto-adopted" ;
    stolos:spec "097-controller FR-001",
        "107-pairing-and-query FR-007" .

stolos:joined-cloud a stolos:WayOfJoining ;
    rdfs:label "cloud"@en ;
    skos:definition "A machine a connected cloud account reports."@en ;
    skos:notation "cloud" ;
    stolos:spec "066-stolos-console FR-003",
        "107-pairing-and-query FR-007" .

stolos:joined-integrated a stolos:WayOfJoining ;
    rdfs:label "integrated"@en ;
    skos:definition "Adopted by hand: `host adopt`, a check-in code from `host integrate`, or a device read over SNMP."@en ;
    skos:notation "integrated" ;
    stolos:spec "069-integrate",
        "107-pairing-and-query FR-007" .

stolos:joined-managed a stolos:WayOfJoining ;
    rdfs:label "managed"@en ;
    skos:definition "A server or workstation Stolos installs and converges."@en ;
    skos:notation "managed" ;
    stolos:spec "002-model",
        "107-pairing-and-query FR-007" .

stolos:joined-paired a stolos:WayOfJoining ;
    rdfs:label "paired"@en ;
    skos:definition "Adopted through `stolos pair`, after the person said yes to its prompt."@en ;
    skos:notation "paired" ;
    stolos:spec "098-pair FR-006",
        "107-pairing-and-query FR-007" .

stolos:kind-adopted a stolos:MachineKind ;
    rdfs:label "adopted"@en ;
    skos:definition "A machine Stolos did not install, observed by its probe."@en ;
    skos:notation "adopted" ;
    stolos:spec "067-adopt" .

stolos:kind-cloud a stolos:MachineKind ;
    rdfs:label "cloud"@en ;
    skos:definition "A machine a connected cloud account reports."@en ;
    skos:notation "cloud" ;
    stolos:spec "066-stolos-console FR-003" .

stolos:kind-controller a stolos:MachineKind ;
    rdfs:label "controller"@en ;
    skos:definition "The PC that runs stolos, an adopted machine observed locally."@en ;
    skos:notation "controller" ;
    stolos:spec "097-controller FR-001" .

stolos:kind-device a stolos:MachineKind ;
    rdfs:label "device"@en ;
    skos:definition "An appliance read over SNMP."@en ;
    skos:notation "device" ;
    stolos:spec "069-integrate FR-005" .

stolos:kind-discovered a stolos:MachineKind ;
    rdfs:label "discovered"@en ;
    skos:definition "A machine found on the network and recorded, not adopted yet."@en ;
    skos:notation "discovered" ;
    stolos:spec "067-adopt" .

stolos:kind-server a stolos:MachineKind ;
    rdfs:label "server"@en ;
    skos:definition "A managed server, installed and converged by archon."@en ;
    skos:notation "server" ;
    stolos:spec "002-model" .

stolos:kind-workstation a stolos:MachineKind ;
    rdfs:label "workstation"@en ;
    skos:definition "A managed workstation (Ubuntu, or Ubuntu on WSL)."@en ;
    skos:notation "workstation" ;
    stolos:spec "020-workstation" .

stolos:line-hint a stolos:LineKind ;
    rdfs:label "hint"@en ;
    skos:definition "An optional feature that is merely off: shown at most once a week for each hint, and always with --verbose."@en ;
    skos:notation "hint" ;
    stolos:spec "105-calm-output FR-008" .

stolos:line-outcome a stolos:LineKind ;
    rdfs:label "outcome"@en ;
    skos:definition "A line the person needs (what was sent, what happens next): always shown."@en ;
    skos:notation "outcome" ;
    stolos:spec "105-calm-output FR-003" .

stolos:line-problem a stolos:LineKind ;
    rdfs:label "problem"@en ;
    skos:definition "A failure or a warning (a cross or a warning mark): always shown, with its code."@en ;
    skos:notation "problem" ;
    stolos:spec "105-calm-output FR-003" .

stolos:line-step a stolos:LineKind ;
    rdfs:label "step"@en ;
    skos:definition "A step or phase that went well: shown only with --verbose."@en ;
    skos:notation "step" ;
    stolos:spec "105-calm-output FR-003" .

stolos:line-waiting a stolos:LineKind ;
    rdfs:label "waiting"@en ;
    skos:definition "Waiting on time or on someone else (an hourglass): shown in the closing block."@en ;
    skos:notation "waiting" ;
    stolos:spec "105-calm-output FR-003" .

stolos:line-yours a stolos:LineKind ;
    rdfs:label "yours"@en ;
    skos:definition "Something that is the person's to do (a lightning mark): always shown, with its command."@en ;
    skos:notation "yours" ;
    stolos:spec "105-calm-output FR-003" .

stolos:listener-boot-http a stolos:Listener ;
    rdfs:label "boot HTTP"@en ;
    skos:definition "The boot server's plain HTTP (UEFI HTTP Boot and GRUB speak only plain HTTP); also door A of pairing."@en ;
    skos:notation "boot-http" ;
    stolos:port 8080 ;
    stolos:protocol "tcp" ;
    stolos:spec "103-three-ports FR-001",
        "103-three-ports FR-004" .

stolos:listener-boot-tftp a stolos:Listener ;
    rdfs:label "boot TFTP"@en ;
    skos:definition "The boot server's TFTP (PXE firmware speaks only plain TFTP)."@en ;
    skos:notation "boot-tftp" ;
    stolos:port 69 ;
    stolos:protocol "udp" ;
    stolos:spec "103-three-ports FR-001" .

stolos:listener-console-https a stolos:Listener ;
    rdfs:label "console HTTPS"@en ;
    skos:definition "The Stolos Console over TLS, on the LAN names; also door B of pairing."@en ;
    skos:notation "console-https" ;
    stolos:port 443 ;
    stolos:protocol "tcp" ;
    stolos:spec "100-remote-access FR-003",
        "103-three-ports FR-001",
        "103-three-ports FR-004" .

stolos:onListener a owl:ObjectProperty ;
    rdfs:domain stolos:Door ;
    rdfs:label "on listener"@en ;
    rdfs:range stolos:Listener ;
    skos:definition "The listener a pairing door is served on."@en ;
    stolos:spec "103-three-ports FR-004" .

stolos:origin-inherited a stolos:TagOrigin ;
    rdfs:label "inherited"@en ;
    skos:definition "Inherited from a group of the fleet's `tags.ts` the machine belongs to."@en ;
    skos:notation "inherited" ;
    stolos:spec "108-tags FR-010" .

stolos:origin-person a stolos:TagOrigin ;
    rdfs:label "person"@en ;
    skos:definition "Added by a person: `stolos tag add`, or the tags of `stolos pair`. It wins over a rule and over a group."@en ;
    skos:notation "person" ;
    stolos:spec "108-tags FR-006, FR-008, FR-011" .

stolos:origin-rule a stolos:TagOrigin ;
    rdfs:label "rule"@en ;
    skos:definition "Given by a rule of the fleet's `tags.ts`, from what Stolos knows of the machine."@en ;
    skos:notation "rule" ;
    stolos:spec "108-tags FR-009" .

stolos:outcome-action a stolos:OutcomeLevel ;
    rdfs:label "action"@en ;
    skos:definition "A step that is the operator's to take (send a change, back up, approve): nothing is wrong."@en ;
    skos:notation "action" ;
    stolos:ascii "[you]" ;
    stolos:emoji "⚡" ;
    stolos:spec "099-engine-update FR-007" .

stolos:outcome-done a stolos:OutcomeLevel ;
    rdfs:label "done"@en ;
    skos:definition "The step did what it was asked."@en ;
    skos:notation "done" ;
    stolos:ascii "[ok]" ;
    stolos:emoji "✅" ;
    stolos:spec "019-output" .

stolos:outcome-failed a stolos:OutcomeLevel ;
    rdfs:label "failed"@en ;
    skos:definition "The step failed: a problem with its fix."@en ;
    skos:notation "failed" ;
    stolos:ascii "[x]" ;
    stolos:emoji "❌" ;
    stolos:spec "019-output" .

stolos:outcome-pending a stolos:OutcomeLevel ;
    rdfs:label "pending"@en ;
    skos:definition "Not set up yet, expected until someone does it: shown with its next step, never a failure."@en ;
    skos:notation "pending" ;
    stolos:ascii "[todo]" ;
    stolos:emoji "⏳" ;
    stolos:spec "052-self-describing" .

stolos:outcome-warning a stolos:OutcomeLevel ;
    rdfs:label "warning"@en ;
    skos:definition "The step finished, with something to look at."@en ;
    skos:notation "warning" ;
    stolos:ascii "[!]" ;
    stolos:emoji "⚠️" ;
    stolos:spec "019-output" .

stolos:output-action a stolos:OutputClass ;
    rdfs:label "action"@en ;
    skos:definition "Does something (update, apply, upgrade, pair, adopt, back up): calm by default, only what needs a person is shown."@en ;
    skos:notation "action" ;
    stolos:spec "105-calm-output FR-001" .

stolos:output-report a stolos:OutputClass ;
    rdfs:label "report"@en ;
    skos:definition "Meant to be read by a person as a whole (a doctor, a status, a long-running server): verbose by default, every line shown."@en ;
    skos:notation "report" ;
    stolos:spec "105-calm-output FR-001" .

stolos:pathPrefix a owl:DatatypeProperty ;
    rdfs:domain stolos:DevicePath ;
    rdfs:label "path prefix"@en ;
    rdfs:range xsd:string ;
    skos:definition "The URL path prefix, with a leading slash and no trailing one."@en ;
    stolos:spec "103-three-ports FR-003" .

stolos:port a owl:DatatypeProperty ;
    rdfs:domain stolos:Listener ;
    rdfs:label "port"@en ;
    rdfs:range xsd:integer ;
    skos:definition "The listener's standard port number (the engine's default for it)."@en ;
    stolos:spec "103-three-ports FR-002" .

stolos:protocol a owl:DatatypeProperty ;
    rdfs:domain stolos:Listener ;
    rdfs:label "protocol"@en ;
    rdfs:range xsd:string ;
    skos:definition "The listener's transport: `tcp` or `udp`."@en ;
    stolos:spec "103-three-ports FR-002" .

stolos:rung-0 a mz:Rung ;
    rdfs:label "Ontology"@en ;
    skos:definition "Terms, classes and code lists, stated once as TypeScript on commons' kernel RDF; Turtle and the code's unions are generated from it."@en ;
    mz:home "ontology/",
        "src/archon/ontology.auto.ts" ;
    mz:kind mz:Required ;
    mz:provedBy "bun run check:ontology",
        "bun run check:trace" ;
    mz:rungNumber 0 ;
    mz:spec "101-ladder FR-001" .

stolos:rung-1 a mz:Rung ;
    rdfs:label "Specifications"@en ;
    skos:definition "What each part must do, in Spec Kit (specify, clarify, plan, tasks, implement), using only terms the ontology defines."@en ;
    mz:home ".specify/",
        "specs/" ;
    mz:kind mz:Required ;
    mz:mayRelyOn stolos:rung-0 ;
    mz:provedBy "bun run check:trace",
        "bun run test" ;
    mz:rungNumber 1 ;
    mz:spec "101-ladder FR-001" .

stolos:rung-2 a mz:Rung ;
    rdfs:label "Governed data"@en ;
    skos:definition "The shapes of what is kept: the fleet model's types and the site's, the estate's tables and the schema language and vocabulary they are declared in."@en ;
    mz:home "src/archon/estate/schema.ts",
        "src/archon/model/site.ts",
        "src/archon/model/types.ts",
        "src/archon/ocsf/classes.ts",
        "src/archon/schema/" ;
    mz:kind mz:Required ;
    mz:mayRelyOn stolos:rung-0,
        stolos:rung-1 ;
    mz:provedBy "bun run check",
        "bun run check:layers" ;
    mz:rungNumber 2 ;
    mz:spec "101-ladder FR-001" .

stolos:rung-3 a mz:Rung ;
    rdfs:label "Data operations"@en ;
    skos:definition "Work as close to the data as possible: the model loaded and validated, the state store (archon.sql), the estate graph and the vault."@en ;
    mz:home "src/archon/estate/",
        "src/archon/model/",
        "src/archon/state/",
        "src/archon/vault/" ;
    mz:kind mz:Required ;
    mz:mayRelyOn stolos:rung-0,
        stolos:rung-1,
        stolos:rung-2 ;
    mz:provedBy "bun run check:layers",
        "bun run test" ;
    mz:rungNumber 3 ;
    mz:spec "101-ladder FR-001" .

stolos:rung-4 a mz:Rung ;
    rdfs:label "Infrastructure rules"@en ;
    skos:definition "Logic every part reuses, neutral to any one service: the core (output, paths, exec, secrets), identity and keys, install, the web front door, telemetry's names, and the use of commons."@en ;
    mz:home ".gitattributes",
        ".gitignore",
        ".vscode/",
        "bun.lock",
        "bunfig.toml",
        "package.json",
        "release.ts",
        "src/archon/assets.auto.ts",
        "src/archon/core/",
        "src/archon/identity/",
        "src/archon/install/",
        "src/archon/telemetry/",
        "src/archon/version.ts",
        "src/archon/web/",
        "tsconfig.json" ;
    mz:kind mz:Required ;
    mz:mayRelyOn stolos:rung-0,
        stolos:rung-1,
        stolos:rung-3 ;
    mz:provedBy "bun run check:layers",
        "bun run test" ;
    mz:rungNumber 4 ;
    mz:spec "101-ladder FR-001" .

stolos:rung-5 a mz:Rung ;
    rdfs:label "Business rules"@en ;
    skos:definition "The engine's own logic: capabilities and what they render, compliance and controls, adopt and pair, access, update, proposals and the other services."@en ;
    mz:home "home/",
        "src/archon/access/",
        "src/archon/adopt/",
        "src/archon/apply/",
        "src/archon/audit/",
        "src/archon/backup/",
        "src/archon/build.ts",
        "src/archon/capabilities/",
        "src/archon/capabilities/mod.ts",
        "src/archon/clients/",
        "src/archon/compliance/",
        "src/archon/connect/",
        "src/archon/containers/",
        "src/archon/controls/",
        "src/archon/device/",
        "src/archon/doctor/",
        "src/archon/dotfiles/",
        "src/archon/evidence/",
        "src/archon/export/",
        "src/archon/fedramp/",
        "src/archon/fleet/",
        "src/archon/guests/",
        "src/archon/guide/",
        "src/archon/notify/",
        "src/archon/observe/",
        "src/archon/ocsf/",
        "src/archon/optin/",
        "src/archon/otelui/",
        "src/archon/people/",
        "src/archon/personas/",
        "src/archon/personas/mod.ts",
        "src/archon/pg/",
        "src/archon/proposal/",
        "src/archon/prov/",
        "src/archon/reconcile/",
        "src/archon/render/",
        "src/archon/report/",
        "src/archon/risk/",
        "src/archon/s3/",
        "src/archon/shell/",
        "src/archon/smb/",
        "src/archon/tools/",
        "src/archon/trust/",
        "src/archon/update/" ;
    mz:kind mz:Required ;
    mz:mayRelyOn stolos:rung-0,
        stolos:rung-1,
        stolos:rung-3,
        stolos:rung-4 ;
    mz:provedBy "bun run check:layers",
        "bun run test" ;
    mz:rungNumber 5 ;
    mz:spec "101-ladder FR-001" .

stolos:rung-6 a mz:Rung ;
    rdfs:label "Application: headless hosts, then windowed hosts"@en ;
    skos:definition "Two bands: the headless hosts (the stolos and archon command lines and their registry, the MCP server, the REST API, the boot server, the bootstrap scripts and the harness's tools), which reach the operations below with no window, session or person present; then the windowed hosts (the Archon and Stolos consoles), which draw a model and call those operations."@en ;
    mz:home ".github/",
        "bin/",
        "src/archon-boot/",
        "src/archon/api/",
        "src/archon/commands/",
        "src/archon/console/",
        "src/archon/main.ts",
        "src/archon/mcp/",
        "src/stolos/",
        "tools/",
        "vendor/" ;
    mz:kind mz:Required ;
    mz:mayRelyOn stolos:rung-0,
        stolos:rung-1,
        stolos:rung-4,
        stolos:rung-5 ;
    mz:provedBy "bun run check:layers",
        "bun run test" ;
    mz:rungNumber 6 ;
    mz:spec "101-ladder FR-001" .

stolos:rung-7 a mz:Rung ;
    rdfs:label "Documentation"@en ;
    skos:definition "The guides (each module's @module documentation, src/**/mod.ts first), docs/, the manuals site (docs.config.ts), the example fleet, this repository's own documents, and the tests that prove every rung below."@en ;
    mz:home "AGENTS.md",
        "LICENSE",
        "LICENSING.md",
        "README.md",
        "docs.config.ts",
        "docs/",
        "examples/",
        "src/**/mod.ts",
        "src/archon/connect/registry-guide.ts",
        "src/archon/install/workstation-guide.ts",
        "src/releasing.ts",
        "tests/" ;
    mz:kind mz:Required ;
    mz:mayRelyOn stolos:rung-0,
        stolos:rung-1,
        stolos:rung-2,
        stolos:rung-3,
        stolos:rung-4,
        stolos:rung-5,
        stolos:rung-6 ;
    mz:provedBy "bun run check:layers",
        "bun run docs:lint" ;
    mz:rungNumber 7 ;
    mz:spec "101-ladder FR-001" .

stolos:signer-daily a stolos:SignerRole ;
    rdfs:label "daily"@en ;
    skos:definition "Approves changes."@en ;
    skos:notation "daily" ;
    stolos:spec "047-intent-and-identity FR-001" .

stolos:signer-recovery a stolos:SignerRole ;
    rdfs:label "recovery"@en ;
    skos:definition "Kept offline, in the vault: replaces a lost or stolen daily key."@en ;
    skos:notation "recovery" ;
    stolos:spec "047-intent-and-identity FR-001",
        "057-keys" .

stolos:signing-failed a stolos:SigningOutcome ;
    rdfs:label "failed"@en ;
    skos:definition "Signing failed for another reason: a passphrase typed for this attempt is thrown away, one kept before stays."@en ;
    skos:notation "failed" ;
    stolos:spec "106-one-passphrase-speed FR-003" .

stolos:signing-refused a stolos:SigningOutcome ;
    rdfs:label "refused"@en ;
    skos:definition "The key did not unlock with the passphrase given: it is thrown away, the person is asked again (three tries in all), and what was kept before stays until a new one unlocks."@en ;
    skos:notation "refused" ;
    stolos:spec "106-one-passphrase-speed FR-003" .

stolos:signing-unlocked a stolos:SigningOutcome ;
    rdfs:label "unlocked"@en ;
    skos:definition "The key unlocked and the commit was signed: the passphrase is kept for the rest of the command."@en ;
    skos:notation "unlocked" ;
    stolos:spec "106-one-passphrase-speed FR-003" .

stolos:spec a owl:DatatypeProperty ;
    rdfs:label "spec"@en ;
    rdfs:range xsd:string ;
    skos:definition "The specification (`NNN-slug`) or requirement (`NNN-slug FR-NNN`) a term comes from; `bun run check:trace` holds it."@en ;
    stolos:spec "101-ladder FR-004",
        "101-ladder FR-007" .

stolos:stage-adopted a stolos:PairingStage ;
    rdfs:label "adopted"@en ;
    skos:definition "The person said yes and the machine was adopted."@en ;
    skos:notation "adopted" ;
    stolos:spec "107-pairing-and-query FR-003" .

stolos:stage-hello a stolos:PairingStage ;
    rdfs:label "said hello"@en ;
    skos:definition "The machine ran the line and its signed hello was answered."@en ;
    skos:notation "hello" ;
    stolos:spec "107-pairing-and-query FR-002" .

stolos:stage-installing a stolos:PairingStage ;
    rdfs:label "installing"@en ;
    skos:definition "The machine fetched the probe: it is turning on SSH and installing it."@en ;
    skos:notation "installing" ;
    stolos:spec "107-pairing-and-query FR-002" .

stolos:stage-refused a stolos:PairingStage ;
    rdfs:label "refused"@en ;
    skos:definition "The person said no, or the machine could not be adopted."@en ;
    skos:notation "refused" ;
    stolos:spec "107-pairing-and-query FR-003" .

stolos:stage-waiting a stolos:PairingStage ;
    rdfs:label "waiting for you"@en ;
    skos:definition "The machine's signed check-in is queued for the person's yes or no."@en ;
    skos:notation "waiting" ;
    stolos:spec "107-pairing-and-query FR-003" .

stolos:tier-destructive a stolos:CommandTier ;
    rdfs:label "destructive"@en ;
    skos:definition "Removes users, packages, data or guests: never served to an agent (Article 17)."@en ;
    skos:notation "destructive" ;
    stolos:spec "030-agent-layer FR-004" .

stolos:tier-mutate a stolos:CommandTier ;
    rdfs:label "mutate"@en ;
    skos:definition "Changes the host."@en ;
    skos:notation "mutate" ;
    stolos:spec "030-agent-layer FR-003" .

stolos:tier-read a stolos:CommandTier ;
    rdfs:label "read"@en ;
    skos:definition "Reads, and changes nothing."@en ;
    skos:notation "read" ;
    stolos:spec "030-agent-layer FR-003" .

stolos:tier-repo a stolos:CommandTier ;
    rdfs:label "repo"@en ;
    skos:definition "Writes the fleet repository."@en ;
    skos:notation "repo" ;
    stolos:spec "030-agent-layer FR-003" .

stolos:verbosity-calm a stolos:Verbosity ;
    rdfs:label "calm"@en ;
    skos:definition "Problems, what is the person's to do and the outcome lines, progress while working; a step that went well is not printed."@en ;
    skos:notation "calm" ;
    stolos:spec "105-calm-output FR-002" .

stolos:verbosity-json a stolos:Verbosity ;
    rdfs:label "json"@en ;
    skos:definition "Nothing drawn: the result as JSON (--json)."@en ;
    skos:notation "json" ;
    stolos:spec "105-calm-output FR-002" .

stolos:verbosity-quiet a stolos:Verbosity ;
    rdfs:label "quiet"@en ;
    skos:definition "One verdict line and the exit code, nothing else (--quiet)."@en ;
    skos:notation "quiet" ;
    stolos:spec "105-calm-output FR-002" .

stolos:verbosity-verbose a stolos:Verbosity ;
    rdfs:label "verbose"@en ;
    skos:definition "Every line, steps that went well included (--verbose)."@en ;
    skos:notation "verbose" ;
    stolos:spec "105-calm-output FR-002" .

<https://intellectual-frontiers.github.io/stolos/ontology> a owl:Ontology ;
    dcterms:description "The terms of Stolos, the fleet engine: the machines of a fleet, its signers and decisions, its checks and findings, the code lists the engine branches on, and the ladder its repository is built on."@en ;
    rdfs:label "Stolos"@en ;
    owl:versionInfo "1.0.1" .

