{
  "name": "@intellectual-frontiers/stolos",
  "version": "0.158.0",
  "description": "Stolos, the fleet engine: the archon command, the boot server, and everything general about turning bare metal into a converged, verified Ubuntu host (spec 096-bun-runtime).",
  "license": "BUSL-1.1",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./*": "./src/*.ts"
  },
  "engines": {
    "node": ">=26",
    "bun": ">=1.4.4"
  },
  "scripts": {
    "stolos": "bun src/stolos/main.ts",
    "archon": "bun src/archon/main.ts",
    "check": "tsc -p tsconfig.json",
    "lint": "bun x bun@1.4.4-canary.20261115.1 lint --no-script --type-aware --max-warnings 0 ontology src tools tests examples docs.config.ts",
    "fmt": "bun fmt",
    "fmt:check": "bun fmt --check",
    "test": "bun tools/test.ts",
    "test:ci": "bun tools/test.ts --runtime bun,node --report tap,junit,ctrf,sarif,md,html,oscal --ledger test-results/ledger.jsonl",
    "gen": "bun tools/gen-assets.ts",
    "check:ontology": "bun tools/ontology.ts --check",
    "check:trace": "bun tools/trace.ts",
    "check:layers": "bun tools/layers.ts",
    "version": "bun tools/version.ts",
    "docs": "ifc-docs build",
    "docs:lint": "ifc-docs check && bun tools/doc-examples.ts",
    "smoke": "bun tools/smoke.ts",
    "ci": "bun tools/gen-assets.ts --check && bun run check && bun run lint && bun fmt --check && bun run docs:lint && bun run check:ontology && bun run check:trace && bun run check:layers && bun run check:mizan && bun run compat:digest --check && bun run test:ci && bun tools/version.ts check origin/main && bun run versions:check",
    "ocsf": "bun tools/ocsf-gen.ts",
    "fedramp": "bun tools/fedramp-gen.ts",
    "unifi-api": "bun tools/unifi-api-gen.ts",
    "check:mizan": "bun tools/mizan.ts",
    "compat:digest": "bun tools/compat-digest.ts",
    "versions:check": "bun node_modules/@intellectual-frontiers/commons/commons/ts/mizan/versions.ts check --base origin/main"
  },
  "dependencies": {
    "@intellectual-frontiers/commons": "github:intellectual-frontiers/.github#7bd74c3ef4276737a4a0dda2a842feb315c46d0d",
    "ajv": "8.17.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intellectual-frontiers/stolos.git"
  }
}
